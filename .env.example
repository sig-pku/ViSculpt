# This file is copied to .env by `uv run visculpt setup`.
# Set only the credentials required by the provider selected in ViSculpt.
LMSTUDIO_API_KEY=
# Custom LLM Base URLs use only this optional key.
CUSTOM_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=

# Optional bearer token configured in the Blender RPC Add-on.
AGENTIC_GEOMETRY_BLENDER_RPC_ACCESS_TOKEN=
